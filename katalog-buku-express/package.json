{
  "name": "katalog-buku-express",
  "version": "1.1.0",
  "private": true,
  "description": "Katalog buku sederhana: Express, Prisma, Neon PostgreSQL, HTML/CSS/JavaScript.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "test": "node --test pendukung/tests/*.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "17.2.3",
    "express": "5.3.0"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
